# SSO Authentication Configuration
# Copy this file to .env.local and fill in your actual values

# Identity Provider (IdP) Configuration
# Replace with your actual IdP endpoints

# OAuth Authorization Endpoint
# Example (Auth0): https://YOUR_DOMAIN.auth0.com/authorize
# Example (Okta): https://YOUR_DOMAIN.okta.com/oauth2/default/v1/authorize
# Example (Azure AD): https://login.microsoftonline.com/YOUR_TENANT_ID/oauth2/v2.0/authorize
VITE_SSO_AUTH_URL=https://your-idp.com/oauth/authorize

# OAuth Logout Endpoint
# Example (Auth0): https://YOUR_DOMAIN.auth0.com/v2/logout
# Example (Okta): https://YOUR_DOMAIN.okta.com/oauth2/default/v1/logout
# Example (Azure AD): https://login.microsoftonline.com/YOUR_TENANT_ID/oauth2/v2.0/logout
VITE_SSO_LOGOUT_URL=https://your-idp.com/oauth/logout

# OAuth Token Endpoint (for code exchange)
# Example (Auth0): https://YOUR_DOMAIN.auth0.com/oauth/token
# Example (Okta): https://YOUR_DOMAIN.okta.com/oauth2/default/v1/token
# Example (Azure AD): https://login.microsoftonline.com/YOUR_TENANT_ID/oauth2/v2.0/token
VITE_SSO_TOKEN_ENDPOINT=https://your-idp.com/oauth/token

# UserInfo Endpoint (to fetch user profile)
# Example (Auth0): https://YOUR_DOMAIN.auth0.com/userinfo
# Example (Okta): https://YOUR_DOMAIN.okta.com/oauth2/default/v1/userinfo
# Example (Azure AD): https://graph.microsoft.com/oidc/userinfo
VITE_SSO_USER_INFO_ENDPOINT=https://your-idp.com/oauth/userinfo

# OAuth Client ID (provided by your IdP)
VITE_SSO_CLIENT_ID=your-client-id

# OAuth Redirect URI (must match the one configured in your IdP)
# For local development, this is typically http://localhost:5173/auth/callback
# For production, use your actual domain
VITE_SSO_REDIRECT_URI=http://localhost:5173/auth/callback

# OAuth Scopes (space-separated)
# Common scopes: openid profile email
# Add custom scopes as needed (e.g., roles permissions)
VITE_SSO_SCOPE=openid profile email

# OAuth Response Type
# For Authorization Code flow (recommended): code
# For Implicit flow (not recommended): token id_token
VITE_SSO_RESPONSE_TYPE=code

# API Base URL (if you have a backend API)
VITE_API_BASE_URL=http://localhost:3000/api

# =========================================================
# Provider-Specific Examples
# =========================================================

# --- Auth0 Example ---
# VITE_SSO_AUTH_URL=https://dev-abc123.auth0.com/authorize
# VITE_SSO_LOGOUT_URL=https://dev-abc123.auth0.com/v2/logout
# VITE_SSO_TOKEN_ENDPOINT=https://dev-abc123.auth0.com/oauth/token
# VITE_SSO_USER_INFO_ENDPOINT=https://dev-abc123.auth0.com/userinfo
# VITE_SSO_CLIENT_ID=your_auth0_client_id
# VITE_SSO_REDIRECT_URI=http://localhost:5173/auth/callback
# VITE_SSO_SCOPE=openid profile email
# VITE_SSO_RESPONSE_TYPE=code

# --- Okta Example ---
# VITE_SSO_AUTH_URL=https://dev-123456.okta.com/oauth2/default/v1/authorize
# VITE_SSO_LOGOUT_URL=https://dev-123456.okta.com/oauth2/default/v1/logout
# VITE_SSO_TOKEN_ENDPOINT=https://dev-123456.okta.com/oauth2/default/v1/token
# VITE_SSO_USER_INFO_ENDPOINT=https://dev-123456.okta.com/oauth2/default/v1/userinfo
# VITE_SSO_CLIENT_ID=your_okta_client_id
# VITE_SSO_REDIRECT_URI=http://localhost:5173/auth/callback
# VITE_SSO_SCOPE=openid profile email
# VITE_SSO_RESPONSE_TYPE=code

# --- Azure AD Example ---
# VITE_SSO_AUTH_URL=https://login.microsoftonline.com/YOUR_TENANT_ID/oauth2/v2.0/authorize
# VITE_SSO_LOGOUT_URL=https://login.microsoftonline.com/YOUR_TENANT_ID/oauth2/v2.0/logout
# VITE_SSO_TOKEN_ENDPOINT=https://login.microsoftonline.com/YOUR_TENANT_ID/oauth2/v2.0/token
# VITE_SSO_USER_INFO_ENDPOINT=https://graph.microsoft.com/oidc/userinfo
# VITE_SSO_CLIENT_ID=your_azure_client_id
# VITE_SSO_REDIRECT_URI=http://localhost:5173/auth/callback
# VITE_SSO_SCOPE=openid profile email
# VITE_SSO_RESPONSE_TYPE=code

# --- Google OAuth Example ---
# VITE_SSO_AUTH_URL=https://accounts.google.com/o/oauth2/v2/auth
# VITE_SSO_LOGOUT_URL=https://accounts.google.com/logout
# VITE_SSO_TOKEN_ENDPOINT=https://oauth2.googleapis.com/token
# VITE_SSO_USER_INFO_ENDPOINT=https://www.googleapis.com/oauth2/v2/userinfo
# VITE_SSO_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
# VITE_SSO_REDIRECT_URI=http://localhost:5173/auth/callback
# VITE_SSO_SCOPE=openid profile email
# VITE_SSO_RESPONSE_TYPE=code
